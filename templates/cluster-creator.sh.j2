#!/bin/bash
{{ ansible_managed | comment }}
source "{{ redis_conf_path }}/cluster-config.sh"

COUNT_NODES=0
COUNT_PONGS=0

{% if redis_cluster_use_hostnames | default(false) %}
# Usa hostnames
for HOST in $HOSTS; do
    COUNT_NODES=$((COUNT_NODES+1))
    PONG=$(redis-cli -h "$HOST" -p "$PORT" PING)
    if [ "$PONG" = "PONG" ]; then
        COUNT_PONGS=$((COUNT_PONGS+1))
    fi
done
{% else %}
# Usa IP
for IP in $HOSTS_IPS; do
    COUNT_NODES=$((COUNT_NODES+1))
    PONG=$(redis-cli -h "$IP" -p "$PORT" PING)
    if [ "$PONG" = "PONG" ]; then
        COUNT_PONGS=$((COUNT_PONGS+1))
    fi
done
{% endif %}

if [ "$COUNT_PONGS" != "$COUNT_NODES" ]; then
    echo "Waiting nodes..."
    exit 1
fi

COUNT_NODES_ON_CLUSTER=$(redis-cli -p "$PORT" cluster nodes | wc -l)
if [ "$COUNT_NODES_ON_CLUSTER" != "1" ]; then
    echo "Nodes already know each others..."
    exit 0
fi

# Construye los puntos finales host:port según el modo
HOSTS_LIST=""
{% if redis_cluster_use_hostnames | default(false) %}
for HOST in $HOSTS; do
  HOSTS_LIST="$HOSTS_LIST $HOST:$PORT"
done
{% else %}
for IP in $HOSTS_IPS; do
  HOSTS_LIST="$HOSTS_LIST $IP:$PORT"
done
{% endif %}

yes "yes" | redis-trib create $REPLICAS $HOSTS_LIST